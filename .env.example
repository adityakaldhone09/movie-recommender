# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard or local .env)
# ==============================================================================

# Required: TMDB API Key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Port binding (Render injects $PORT automatically; defaults to 8000 locally)
PORT=8000

# Optional: Comma-separated additional browser origins allowed by the backend.
# The production Vercel origin and local development origins are already allowlisted.
ALLOWED_ORIGINS=

# Optional: Streamlit legacy client target (defaults to http://127.0.0.1:8000)
API_BASE_URL=http://127.0.0.1:8000


# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ==============================================================================

# Public Render API base URL (no trailing slash). This is not a credential.
VITE_API_BASE_URL=https://movie-recommender-3zs7.onrender.com
