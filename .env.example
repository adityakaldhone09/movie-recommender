# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard or local .env)
# ==============================================================================

# Required: TMDB API Key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Port binding (Render injects $PORT automatically; defaults to 8000 locally)
PORT=8000

# Optional: Comma-separated production origins allowed to access the backend API
# Example: https://your-movie-app.vercel.app,https://customdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Regex matching Vercel preview and production deployments
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Optional: Streamlit legacy client target (defaults to http://127.0.0.1:8000)
API_BASE_URL=http://127.0.0.1:8000


# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ==============================================================================

# Production URL of your deployed Render backend (no trailing slash).
# Example: https://movie-recommender-api.onrender.com
# Leave empty for local development to use the Vite proxy to http://127.0.0.1:8000.
VITE_API_BASE_URL=https://your-backend-service.onrender.com
